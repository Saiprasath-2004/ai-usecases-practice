# --- LLM provider (required) ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_PRIMARY_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=llama3-8b-8192

# Optional: OpenRouter fallback path, only used if your llm/client.py wires it in
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
FALLBACK_OPENROUTER_MODEL=

EXTRACTION_MAX_RETRIES=2

# --- Decision thresholds ---
SELECT_CUTOFF=70.0
REJECT_FLOOR=35.0

# --- Follow-up ---
FOLLOWUP_MAX_QUESTIONS=3
FOLLOWUP_TIMEOUT_DAYS=7

# --- Persistence ---
CHECKPOINT_DB_PATH=checkpoints.sqlite
ACTIONS_DB_PATH=actions_outbox.sqlite

# --- Mock email provider (swap for real SMTP/API later) ---
EMAIL_PROVIDER=MOCK
EMAIL_API_KEY=mock-key-12345
EMAIL_SENDER_ADDRESS=recruiter@company.com

# --- CORS: must include the frontend's dev origin ---
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
